apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: my-java-backend-test
  namespace: argocd
  annotations:
spec:
  project: default
  source:
    repoURL: https://github.com/uchihaph/my-java-backend-demo.git
    targetRevision: main
    path: k8s/overlays/test
    kustomize:
      commonAnnotations:
        managed-by: argocd
  destination:
    server: https://kubernetes.default.svc
    namespace: test
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: my-java-backend-prod
  namespace: argocd
  annotations:
spec:
  project: default
  source:
    repoURL: https://github.com/uchihaph/my-java-backend-demo.git
    targetRevision: main
    path: k8s/overlays/prod
    kustomize:
      commonAnnotations:
        managed-by: argocd
  destination:
    server: https://kubernetes.default.svc
    namespace: prod
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
